# ==============================================================================
# MediChain Cross-Chain Sovereign Healthcare System Environment Configuration
# Never commit your real .env file. Keep secrets in .env only.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. EVM PRIVATE KEYS & MULTISIG (Sepolia & Polygon Amoy)
# ------------------------------------------------------------------------------
# Contract Deployment: 64-character hex private key for deploying smart contracts
DEPLOYER_PRIVATE_KEY=""

# Gateway Relayer: 64-character hex private key for hospital gateway relayers (gas sponsorship & cross-chain proofs)
RELAYER_PRIVATE_KEY=""

# Safe (Gnosis Safe) 2-of-3 Multisig address deployed on Ethereum Sepolia
SEPOLIA_SAFE_MULTISIG_ADDRESS=""

# ------------------------------------------------------------------------------
# 2. RPC ENDPOINTS & ALCHEMY
# ------------------------------------------------------------------------------
# Free-tier Alchemy API Key (or full URL)
ALCHEMY_API_KEY=""

# Network A: Ethereum Sepolia (Chain ID: 11155111)
SEPOLIA_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY"

# Network B: Polygon Amoy (Chain ID: 80002)
AMOY_RPC_URL="https://polygon-amoy-bor-rpc.publicnode.com"

# Network B Fallback: Arbitrum Sepolia (Chain ID: 421614)
ARBITRUM_SEPOLIA_RPC_URL="https://sepolia-rollup.arbitrum.io/rpc"

# ------------------------------------------------------------------------------
# 3. NETWORK C: ALGORAND TESTNET (AVM)
# ------------------------------------------------------------------------------
# Smart Contract Deployment: 25-word mnemonic phrase for deploying Diagnostic Lab TEAL application
ALGORAND_DEPLOYER_MNEMONIC=""

# Gateway Relayer: 25-word mnemonic phrase for Diagnostic Lab relayer account
ALGORAND_RELAYER_MNEMONIC=""

# PureStake / AlgoNode public free endpoint (No credit card or paid key needed)
ALGORAND_ALGOD_URL="https://testnet-api.algonode.cloud"
ALGORAND_ALGOD_PORT=443
ALGORAND_ALGOD_TOKEN=""
ALGORAND_INDEXER_URL="https://testnet-idx.algonode.cloud"

# Algorand Diagnostic Lab Smart Contract Application ID (Generated after deploy)
ALGORAND_APP_ID=""

# ------------------------------------------------------------------------------
# 4. DECENTRALIZED STORAGE: PINATA IPFS
# ------------------------------------------------------------------------------
# Pinata Free Tier API Credentials (https://app.pinata.cloud/developers/api-keys)
PINATA_API_KEY=""
PINATA_API_SECRET=""
PINATA_JWT=""
PINATA_GATEWAY_URL="https://gateway.pinata.cloud/ipfs"

# ------------------------------------------------------------------------------
# 5. OFF-CHAIN RELATIONAL DATABASE: NEON POSTGRESQL (SERVERLESS PRISMA)
# ------------------------------------------------------------------------------
# Neon free tier connection string (https://console.neon.tech)
DATABASE_URL="postgresql://user:password@ep-cool-sample.us-east-2.aws.neon.tech/medichain?sslmode=require"

# ------------------------------------------------------------------------------
# 6. LOCAL REPO FALLBACK STORAGE & AUTHENTICATION
# ------------------------------------------------------------------------------
STORAGE_DIR="./storage"
JWT_SECRET="replace_with_a_secure_random_32_character_string_for_production"
JWT_EXPIRES_IN="8h"
PORT=3000
